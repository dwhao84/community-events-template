{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploy-button friendly: no account IDs, no database IDs, no custom domain.
  // Wrangler provisions the D1 database and R2 bucket on first deploy.
  // Local development overrides APP_ENV / SITE_URL through .dev.vars (see .dev.vars.example).
  "name": "community-events",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "APP_ENV": "production",
    "SITE_URL": "",
    "MAIL_MODE": "disabled",
    "MAIL_FROM": "",
    "MAIL_REPLY_TO": "",
    "MAIL_CC": "",
    "GA4_MEASUREMENT_ID": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "MAX_PHOTO_BYTES": "8388608",
    "MAX_PHOTO_DIMENSION": "6000"
  },
  "d1_databases": [{"binding": "DB", "database_name": "community-events", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "PHOTOS", "bucket_name": "community-events-photos"}]
}
